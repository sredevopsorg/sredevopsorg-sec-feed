# Local environment for Docker Compose. Copy this file and fill in real values:
#
#   cp .env.example .env
#   chmod 600 .env
#
# `.env` is gitignored and must never be committed with real credentials. It is
# read by Compose for the `postgres`, `postgres-init`, `migrate`, and `api`
# services (the local stack fails closed without the POSTGRES_* values).
#
# Generate strong passwords, e.g. with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'

# --- Local PostgreSQL (base docker-compose.yml) -----------------------------
# Dev-only defaults: rotate these before running anything production-like.
POSTGRES_USER=feed
POSTGRES_PASSWORD=change-me-generate-a-strong-password
POSTGRES_DB=feed

# --- Hosted Supabase (docker-compose.supabase.yml overlay) ------------------
# The API must use the DML-only role (`feed_app.PROJECT-REF`); the migration
# job uses the privileged `postgres.PROJECT-REF` role. Create both out of band;
# see README "Hosted Supabase". Session-mode pooler host comes from the
# dashboard Connect dialog.
# DATABASE_URL=postgresql://feed_app.PROJECT-REF:APP_PASSWORD@HOST:5432/postgres
# ADMIN_DATABASE_URL=postgresql://postgres.PROJECT-REF:ADMIN_PASSWORD@HOST:5432/postgres
# DB_SSLMODE=require
# DB_PREPARE_THRESHOLD=5            # only for direct/session mode, never transaction mode
# DB_POOL_MAX_SIZE=4
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_IDLE_TX_TIMEOUT_MS=30000
# DB_LOCK_TIMEOUT_MS=5000
# DB_SSLROOTCERT=/path/to/prod-supabase.cer   # only with DB_SSLMODE=verify-full
# DB_POOL_TIMEOUT=30
# DB_POOL_MAX_IDLE=600
# DB_POOL_MAX_LIFETIME=3600
